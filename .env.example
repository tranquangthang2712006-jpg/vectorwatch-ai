# Sao chép thành .env (run.sh / run.bat tự làm việc này nếu chưa có).
# KHÔNG đưa file .env thật lên kho mã nguồn.

# Mật khẩu chung cho 4 tài khoản demo. Đổi trước khi trình diễn công khai,
# rồi chạy lại: cd backend && python -m app.seed --reset
VW_DEMO_PASSWORD=vectorwatch-demo

# Khóa ký token đăng nhập. Để trống → sinh ngẫu nhiên mỗi lần khởi động (phải đăng nhập lại sau khi restart).
VW_SECRET_KEY=

# Độ trễ (giây) giữa các bước workflow để theo dõi tiến trình trên Agent Center. 0 = chạy nhanh nhất.
VW_STEP_DELAY=0.9

# Nhà cung cấp LLM:
#   simulated          — mặc định, phân loại/diễn đạt theo luật, không gọi mô hình nào (không cần khóa)
#   openai_compatible  — gọi API kiểu OpenAI /chat/completions (OpenAI, Groq, OpenRouter, Ollama, Gemini endpoint tương thích…)
# LLM chỉ phân loại ý định và diễn đạt lại câu trả lời; KHÔNG tính ESS/PIS, KHÔNG ghi dữ liệu.
# Đầu ra LLM bị kiểm tra; LLM lỗi hoặc trả sai thì hệ thống tự dùng luật dự phòng.
VW_LLM_PROVIDER=simulated
# Ví dụ OpenAI:  VW_LLM_BASE_URL=https://api.openai.com/v1   VW_LLM_MODEL=gpt-4o-mini
# Ví dụ Ollama:  VW_LLM_BASE_URL=http://localhost:11434/v1  VW_LLM_MODEL=qwen2.5:7b  (không cần khóa)
VW_LLM_BASE_URL=
VW_LLM_MODEL=
# Khóa API — chỉ đặt trong file .env của máy bạn, KHÔNG đưa lên kho mã hay gửi cho người khác.
VW_LLM_API_KEY=
VW_LLM_TIMEOUT=20

# Đường dẫn CSDL SQLite (mặc định backend/data/vectorwatch.db)
# VW_DB_PATH=
